{
    "ai": {
        "enableCelestialMode": true
    },
    "appearance": {
        "deformScale": 1,
        "padding": {
            "scale": 0.8
        },
        "rounding": {
            "scale": 1
        },
        "spacing": {
            "scale": 1
        },
        "transparency": {
            "base": 0.65,
            "enabled": true,
            "layers": 0.1
        }
    },
    "audio": {
        "sounds": {
            "enabled": true,
            "notificationVolume": 0.4,
            "sfxVolume": 0.4
        }
    },
    "background": {
        "desktopLyrics": {
            "enabled": true,
            "position": "bottom-center",
            "scale": 1.2,
            "shadow": {
                "blur": 0.4,
                "enabled": true,
                "opacity": 0.9
            }
        },
        "visualiser": {
            "enabled": true
        }
    },
    "bar": {
        "activeWindow": {
            "compact": true
        },
        "clock": {
            "background": false,
            "showDate": true,
            "showIcon": false,
            "showSeconds": false
        },
        "dock": {
            "monitorCenter": false,
            "recolourIcons": false
        },
        "entries": {
            "center": [
                {
                    "enabled": true,
                    "id": "dock"
                }
            ],
            "end": [
                {
                    "enabled": true,
                    "id": "tray"
                },
                {
                    "enabled": true,
                    "id": "clock"
                },
                {
                    "enabled": true,
                    "id": "statusIcons"
                },
                {
                    "enabled": true,
                    "id": "power"
                }
            ],
            "start": [
                {
                    "enabled": true,
                    "id": "logo"
                },
                {
                    "enabled": true,
                    "id": "workspaces"
                },
                {
                    "enabled": true,
                    "id": "activeWindow"
                }
            ]
        },
        "persistent": true,
        "position": "bottom",
        "statusIcons": [
            {
                "enabled": true,
                "id": "lockStatus"
            },
            {
                "enabled": false,
                "id": "audio"
            },
            {
                "enabled": true,
                "id": "microphone"
            },
            {
                "enabled": false,
                "id": "kbLayout"
            },
            {
                "enabled": true,
                "id": "network"
            },
            {
                "enabled": true,
                "id": "bluetooth"
            },
            {
                "enabled": true,
                "id": "battery"
            },
            {
                "enabled": false,
                "id": "peripheralBattery"
            },
            {
                "enabled": true,
                "id": "notifications"
            }
        ],
        "tray": {
            "compact": false
        },
        "workspaces": {
            "activeIndicator": true,
            "activeTrail": true,
            "maxWindowIcons": 3,
            "occupiedBg": false,
            "showUnoccupied": true,
            "showWindows": true,
            "showWindowsOnSpecialWorkspaces": false,
            "shown": 4,
            "useIcon": true
        }
    },
    "border": {
        "rounding": 25,
        "smoothing": 20,
        "thickness": 8
    },
    "dashboard": {
        "profilePicShape": 17,
        "randomizeMediaShapeColors": true,
        "replaceMediaLyricsWithVisuals": false,
        "showHyprlandSplash": true,
        "showTerminal": false,
        "showWeather": false
    },
    "general": {
        "apps": {
            "explorer": [
                "atlas"
            ],
            "playback": [
                "celluloid"
            ]
        },
        "developerMode": true,
        "idle": {
            "inhibitWhenAudio": true,
            "lockBeforeSleep": true,
            "timeouts": [
            ]
        },
        "logo": "caelestia",
        "mediaGifSpeedAdjustment": 125
    },
    "launcher": {
        "actionPrefix": ">",
        "actions": [
            {
                "command": [
                    "autocomplete",
                    "clipboard"
                ],
                "dangerous": false,
                "description": "View clipboard history",
                "enabled": true,
                "icon": "content_paste",
                "name": "Clipboard"
            },
            {
                "command": [
                    "autocomplete",
                    "emoji"
                ],
                "dangerous": false,
                "description": "Pick an emoji to copy",
                "enabled": true,
                "icon": "emoji_emotions",
                "name": "Emoji"
            },
            {
                "command": [
                    "autocomplete",
                    "calc"
                ],
                "dangerous": false,
                "description": "Do simple math equations (powered by Qalc)",
                "enabled": true,
                "icon": "calculate",
                "name": "Calculator"
            },
            {
                "command": [
                    "autocomplete",
                    "scheme"
                ],
                "dangerous": false,
                "description": "Change the current colour scheme",
                "enabled": true,
                "icon": "palette",
                "name": "Scheme"
            },
            {
                "command": [
                    "autocomplete",
                    "wallpaper"
                ],
                "dangerous": false,
                "description": "Change the current wallpaper",
                "enabled": true,
                "icon": "image",
                "name": "Wallpaper"
            },
            {
                "command": [
                    "caelestia",
                    "wallpaper",
                    "-r"
                ],
                "dangerous": false,
                "description": "Switch to a random wallpaper",
                "enabled": true,
                "icon": "casino",
                "name": "Random"
            },
            {
                "command": [
                    "autocomplete",
                    "variant"
                ],
                "dangerous": false,
                "description": "Change the current scheme variant",
                "enabled": true,
                "icon": "colors",
                "name": "Variant"
            },
            {
                "command": [
                    "setMode",
                    "light"
                ],
                "dangerous": false,
                "description": "Change the scheme to light mode",
                "enabled": true,
                "icon": "light_mode",
                "name": "Light"
            },
            {
                "command": [
                    "setMode",
                    "dark"
                ],
                "dangerous": false,
                "description": "Change the scheme to dark mode",
                "enabled": true,
                "icon": "dark_mode",
                "name": "Dark"
            },
            {
                "command": [
                    "loginctl",
                    "poweroff"
                ],
                "dangerous": true,
                "description": "Shutdown the system",
                "enabled": true,
                "icon": "power_settings_new",
                "name": "Shutdown"
            },
            {
                "command": [
                    "loginctl",
                    "reboot"
                ],
                "dangerous": true,
                "description": "Reboot the system",
                "enabled": true,
                "icon": "cached",
                "name": "Reboot"
            },
            {
                "command": [
                    "uwsm",
                    "stop"
                ],
                "dangerous": true,
                "description": "Log out of the current session",
                "enabled": true,
                "icon": "exit_to_app",
                "name": "Logout"
            },
            {
                "command": [
                    "loginctl",
                    "lock-session"
                ],
                "dangerous": false,
                "description": "Lock the current session",
                "enabled": true,
                "icon": "lock",
                "name": "Lock"
            },
            {
                "command": [
                    "loginctl",
                    "suspend"
                ],
                "dangerous": false,
                "description": "Suspend then hibernate",
                "enabled": true,
                "icon": "bedtime",
                "name": "Sleep"
            },
            {
                "command": [
                    "caelestia",
                    "shell",
                    "nexus",
                    "open"
                ],
                "dangerous": false,
                "description": "Configure the shell",
                "enabled": true,
                "icon": "settings",
                "name": "Settings"
            },
            {
                "command": [
                    "autocomplete",
                    "windows"
                ],
                "dangerous": false,
                "description": "Switch to another window",
                "enabled": true,
                "icon": "apps",
                "name": "Windows"
            },
            {
                "command": [
                    "autocomplete",
                    "keybinds"
                ],
                "dangerous": false,
                "description": "View all keybinds",
                "enabled": true,
                "icon": "keyboard",
                "name": "Keybinds"
            }
        ],
        "enableDangerousActions": false,
        "favouriteApps": [
            "zen",
            "org.telegram.desktop",
            "SONE",
            "equibop",
            "steam",
            "cortana"
        ],
        "hiddenApps": [
            "xfce4-about",
            "cmake-gui",
            "vim",
            "qvidcap",
            "qv4l2",
            "bssh",
            "bvnc",
            "avahi-discover",
            "thunar-settings",
            "org.kde.kdeconnect.nonplasma",
            "org.kde.kdeconnect.sms",
            "thunar-bulk-rename",
            "footclient",
            "foot-server",
            "mpv",
            "uuctl",
            "net.retrodeck.retrodeck.Configurator",
            "net.retrodeck.retrodeck",
            "lstopo",
            "designer",
            "qdbusviewer",
            "assistant",
            "linguist"
        ],
        "showOnHover": false,
        "specialPrefix": "@",
        "useFuzzy": {
            "apps": true,
            "wallpapers": true
        }
    },
    "lock": {
        "enableHowdy": false,
        "lockOnStartup": true,
        "profilePicShape": 18,
        "useWallpaper": true
    },
    "notifs": {
        "actionOnClick": true,
        "defaultExpireTimeout": 3000,
        "groupPreviewNum": 3
    },
    "osd": {
        "enableBrightness": true,
        "enableMicrophone": true,
        "enabled": true,
        "hideDelay": 1000
    },
    "paths": {
        "lyricsDir": "~/Music/Lyrics",
        "mediaGif": "root:/assets/toothless.gif",
        "sessionGif": "root:/assets/cortana.png",
        "wallpaperDir": "~/Pictures/Wallpaper"
    },
    "services": {
        "arpcCaelestiaInfo": false,
        "arpcEnabled": false,
        "defaultPlayer": "Tidal Hi-Fi",
        "lyricsBackend": "Auto",
        "pipFollowFocus": true,
        "pipPaused": false,
        "quickShareAutoStart": false,
        "visualiserBars": 60,
        "weatherLocation": "Orvieto"
    },
    "session": {
        "commands": {
            "logout": [
                "uwsm",
                "stop"
            ],
            "reboot": [
                "sh",
                "-c",
                "cortana service &>/dev/null && cortana api computer -cmd Reboot | cortana notify || systemctl reboot"
            ],
            "shutdown": [
                "sh",
                "-c",
                "cortana service &>/dev/null && cortana api computer -cmd Shutdown | cortana notify || systemctl poweroff"
            ],
            "steam": [
                "sh",
                "-c",
                "steamos-session-select gamescope || systemctl reboot"
            ],
            "suspend": [
                "suspend"
            ],
            "windows": [
                "sh",
                "-c",
                "cortana service &>/dev/null && cortana api computer -cmd BootIntoOtherOperatingSystem | cortana notify || systemctl reboot"
            ]
        },
        "icons": {
            "logout": "exit_to_app",
            "reboot": "cached",
            "shutdown": "power_settings_new",
            "steam": "stadia_controller",
            "suspend": "bedtime",
            "windows": "window"
        }
    },
    "shimeji": {
        "enabled": false
    },
    "utilities": {
        "enabled": true,
        "gameMode": {
            "autoEnable": true,
            "autoEnableRegexes": [
                "^steam_app_\\d+$",
                "^gamescope$"
            ]
        },
        "maxToasts": 1,
        "quickToggles": [
            {
                "enabled": true,
                "id": "wifi"
            },
            {
                "enabled": true,
                "id": "mic"
            },
            {
                "enabled": true,
