            },
            {
                "enabled": true,
                "id": "bluetooth"
            },
            {
                "enabled": false,
                "id": "dnd"
            },
            {
                "enabled": true,
                "id": "gameMode"
            },
            {
                "enabled": false,
                "id": "vpn"
            },
            {
                "enabled": true,
                "id": "wallpaper"
            },
            {
                "enabled": true,
                "id": "quickshare"
            },
            {
                "enabled": true,
                "id": "settings"
            },
            {
                "enabled": false,
                "id": "badapple"
            },
            {
                "enabled": false,
                "id": "pauseWallpaper"
            },
            {
                "enabled": false,
                "id": "pipPause"
            }
        ],
        "toasts": {
            "capsLockChanged": true,
            "kbLayoutChanged": false,
            "kbLimit": false,
            "nowPlaying": false,
            "transparency": true
        },
        "vpn": {
            "enabled": false
        }
    }
