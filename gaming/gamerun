#!/usr/bin/env bash

NVAPI_STATUS=0
MANGOHUD_TYPE=0
GAMESCOPE=0
OPTISCALER=0

GAME_CMD=()
GAME_ENV=(
    "PROTON_PRIORITY_HIGH=1"
    "PROTON_DISCORD_BRIDGE=1"
    "PROTON_LOCAL_SHADER_CACHE=1"
    "ENABLE_LAYER_MESA_ANTI_LAG=1"
)

while [[ $# -gt 0 ]]; do
    case "$1" in
        --nvapi) NVAPI_STATUS=1; shift ;;
        --no-nvapi) NVAPI_STATUS=2; shift ;;
        --mangohud) MANGOHUD_TYPE=1; shift ;;
        --mangoapp) MANGOHUD_TYPE=2; shift ;;
        --gamescope) GAMESCOPE=1; shift ;;
        --optiscaler) OPTISCALER=1; shift ;;
        --) shift; GAME_CMD+=("$@"); break ;;
        -*) echo "Error: Unknown or unsupported flag '$1'"; exit 1 ;;
        *) GAME_CMD+=("$@"); break ;;
    esac
done

if [[ ${#GAME_CMD[@]} -eq 0 ]]; then
    echo "Error: No game executable provided."
    exit 1
fi

if [[ $NVAPI_STATUS -eq 1 ]]; then
    GAME_ENV+=("PROTON_ENABLE_NVAPI=1")
elif [[ $NVAPI_STATUS -eq 2 ]]; then
    GAME_ENV+=("PROTON_DISABLE_NVAPI=1")
fi

if [[ $OPTISCALER -eq 1 ]]; then
    GAME_ENV+=("WINEDLLOVERRIDES=dxgi=n,b")
fi

LAUNCH_CMD=(app2unit --)

WRAPPER=(gamemoderun "${GAME_CMD[@]}")
if [[ $MANGOHUD_TYPE -eq 1 ]]; then
    WRAPPER=(gamemoderun mangohud "${GAME_CMD[@]}")
fi

if [[ $GAMESCOPE -eq 1 ]]; then
    CURRENT_HZ=$(hyprctl monitors -j 2>/dev/null | jq '.[] | select(.focused) | .refreshRate | round' 2>/dev/null || echo "60")

    GAMESCOPE_ARGS=(
        -W 1920 -H 1080 -f -r "$CURRENT_HZ" --force-grab-cursor
    )

    if [[ $CURRENT_HZ -eq 165 ]]; then
        GAMESCOPE_ARGS+=("--adaptive-sync")
    fi

    if [[ $MANGOHUD_TYPE -eq 2 ]]; then
        GAMESCOPE_ARGS+=("--mangoapp")
    fi

    LAUNCH_CMD+=(env LD_PRELOAD="" gamescope "${GAMESCOPE_ARGS[@]}" --)
else
    GAME_ENV+=("PROTON_ENABLE_WAYLAND=1")
fi

LAUNCH_CMD+=(env "${GAME_ENV[@]}" "${WRAPPER[@]}")

ACTIVE_CLASS=$(hyprctl activewindow -j 2>/dev/null | jq -r '.class' 2>/dev/null)
if [[ "${ACTIVE_CLASS,,}" == *"steam"* ]]; then
    hyprctl dispatch killactive
fi

exec systemd-inhibit --why "Gaming" powerprofilesctl launch -p performance -- "${LAUNCH_CMD[@]}"