pkgname=astra-wormhole-git
pkgver=0
pkgrel=1
pkgdesc="Material 3 Expressive XDG Desktop Portal backend for Wayland and Hyprland"
arch=('x86_64')
url="https://github.com/AstraSuite/Wormhole"
license=('GPL-3.0-only')

depends=(
    'qt6-base'
    'qt6-declarative'
    'qt6-svg'
    'qt6-multimedia'
    'glib2'
    'pipewire'
    'wayland'
    'wayland-protocols'
)

makedepends=(
    'cmake'
    'ninja'
    'pkgconf'
    'git'
)

source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/$pkgname"

    if git describe --tags --match 'v[0-9]*' --abbrev=0 >/dev/null 2>&1; then
        git describe --tags --match 'v[0-9]*' --abbrev=0 |
            sed 's/^v//'
    else
        printf '0.%s\n' "$(git log -1 --format=%cd --date=format:%Y%m%d)"
    fi
}

build() {
    cd "$srcdir/$pkgname"

    cmake -B build \
        -S . \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DWORMHOLE_VERSION="$pkgver"

    cmake --build build
}

check() {
    cd "$srcdir/$pkgname"

    ctest \
        --test-dir build \
        --output-on-failure
}

package() {
    cd "$srcdir/$pkgname"

    DESTDIR="$pkgdir" cmake --install build

    install -Dm644 LICENSE \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
